{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/thehaircraft/browser",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}